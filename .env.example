# Documentation only: the application reads environment variables, not this file.
DATA_MODE=demo
ADMIN_USERNAME=admin
# Oracle mode requires a Werkzeug scrypt hash and a long random session secret.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
COOKIE_SECURE=0
HOST=127.0.0.1
PORT=8091
# Use a dedicated SELECT-only account, never the existing recorder account.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_CONFIG_DIR=
ORACLE_WALLET_LOCATION=
ORACLE_WALLET_PASSWORD=
# Confirm the timezone used for database TIMESTAMP columns before connecting.
ORACLE_DB_TIMEZONE=Asia/Tokyo
# Optional thick mode; must be configured before creating connections.
ORACLE_CLIENT_LIB_DIR=
STALE_SECONDS=120

# Member onboarding: demo always writes only its own local SQLite/jdex.
# Oracle writes are disabled until explicitly enabled with separate credentials.
ALLOW_MEMBER_CREATE=0
WRITE_ORACLE_USER=
WRITE_ORACLE_PASSWORD=
SHOWROOM_INDEX_DIR=/home/ubuntu/showroom/index
# Persistent operation journal and index backups; must be writable by service user.
MEMBER_STATE_DIR=/var/lib/showroom-admin

# Local Mac configuration is loaded from local_settings.json (see example JSON).
# Environment variables override JSON. .env itself is still not auto-loaded.
SHOWROOM_INDEX_TRANSPORT=ssh
SHOWROOM_SSH_HOST=your-3c-ssh-alias
SHOWROOM_REMOTE_BACKUP_DIR=/home/ubuntu/showroom-admin-backups
# Optional two-line username/password files, avoiding password copies:
ORACLE_CREDENTIALS_FILE=
WRITE_ORACLE_CREDENTIALS_FILE=

# Log workspace: fixed directory /home/ubuntu/logs; strict SSH host checking.
SHOWROOM_SSH_USER=ubuntu
SHOWROOM_SSH_IDENTITY_FILE=
SHOWROOM_SSH_KNOWN_HOSTS=
LOG_1C_HOST=your-1c-ssh-alias
LOG_1C_USER=ubuntu
LOG_1C_IDENTITY_FILE=
LOG_4C_HOST=your-4c-ssh-alias
LOG_4C_USER=ubuntu
LOG_4C_IDENTITY_FILE=
# Desktop language preference is saved in its private settings.json.
UI_LANGUAGE=zh
